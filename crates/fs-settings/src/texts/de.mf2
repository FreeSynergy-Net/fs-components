# Die Woerter der Standard-Einstellungen, Deutsch (ADR 0057: MessageFormat 2). Jede Id hat ein englisches Gegenstueck in en.mf2.
setting-label-fs-shell-language = Sprache
setting-about-fs-shell-language = Die Sprache der Wörter des Programms.
setting-label-fs-look-style = Stil
setting-about-fs-look-style = Das Aussehen des Programms (sein Stil).
setting-label-fs-look-scheme = Hell oder dunkel
setting-about-fs-look-scheme = Helle oder dunkle Farben; ohne Auswahl entscheidet das System.
setting-label-fs-shell-frontend = Frontend des Programms
setting-about-fs-shell-frontend = Das Frontend, das das Programm öffnet. Ohne Auswahl gilt die eigene Voreinstellung des Programms.
setting-label-fs-shell-refresh-ms = Änderungen prüfen alle (ms)
setting-about-fs-shell-refresh-ms = Wie oft das Programm bei offenem Fenster nach geänderten Einstellungen sieht.
setting-error-reason-missing = Das Sperren von {$key} braucht einen Grund.
# Die Codes von SettingCode (31): ein Satz je Code, `setting-error-<code>`; die Platzhalter sind seine Parameter
setting-error-key-invalid = Der Name {$key} ist kein gültiger Einstellungsschlüssel.
setting-error-program-invalid = Der Programmname {$program} ist nicht gültig.
setting-error-duplicate-key = Die Einstellung {$key} ist doppelt deklariert.
setting-error-default-invalid = Die Voreinstellung von {$key} passt nicht zu ihrer Art.
setting-error-not-declared = Kein Baustein deklariert die Einstellung {$key}.
setting-error-wrong-type = Der Wert von {$key} in der Schicht {$layer} hat den falschen Typ.
setting-error-out-of-range = Der Wert von {$key} in der Schicht {$layer} liegt außerhalb des erlaubten Bereichs.
setting-error-unknown-choice = Der Wert von {$key} in der Schicht {$layer} gehört nicht zur Auswahl.
setting-error-bad-language = Der Wert von {$key} in der Schicht {$layer} ist kein gültiges Sprachkürzel.
setting-error-text-too-long = Der Text von {$key} in der Schicht {$layer} ist zu lang.
setting-error-locked = {$key} ist von {$by} gesperrt: {$reason}
setting-error-lock-refused = Die Sperre auf {$key} hält nichts, weil ihr Wert nicht passt.
setting-error-unknown-key = Das Programm kennt die Einstellung {$key} nicht (Schicht {$layer}); sie bleibt erhalten.
setting-error-file-unreadable = Die Datei {$file} konnte nicht gelesen werden ({$kind}).
setting-error-file-broken = Die Datei {$file} ist kaputt.
setting-error-file-too-large = Die Datei {$file} ist zu groß.
setting-error-not-regular = {$file} ist keine gewöhnliche Datei.
setting-error-write-failed = Die Datei {$file} konnte nicht geschrieben werden ({$kind}); nichts wurde geändert.
setting-error-no-folder = Es gibt keinen Ordner für die Einstellungen ({$which}); die Voreinstellungen gelten.
setting-error-no-right = Du darfst die Instanz-Einstellung {$key} nicht sperren oder ändern.
setting-error-profile = Das Profil {$name} wurde abgelehnt ({$cause}).
setting-error-store-broken = Der Einstellungsspeicher {$file} ist beschädigt ({$cause}); die Voreinstellungen gelten, nichts wird überschrieben.
setting-error-store-newer = Der Einstellungsspeicher {$file} stammt von einem neueren Programm (Version {$found}, dieses kennt {$known}); er wird nicht geöffnet.
setting-error-store-unreachable = Der Einstellungsdienst unter {$socket} ist nicht erreichbar; die Voreinstellungen gelten.
setting-error-store-busy = Der Einstellungsspeicher ist beschäftigt; versuche es noch einmal.
setting-error-read-only = Die Einstellungen ({$which}) sind gerade nur lesbar.
setting-error-index-changed = Die Profilliste hat sich inzwischen geändert; versuche es noch einmal.
setting-error-import-invalid = Die Datei {$file} passt nicht, Zeile {$line}: {$cause}. Nichts wurde geändert.
setting-error-import-conflict = Der Wert von {$key} wurde nicht importiert ({$cause}).
setting-error-export-failed = Der Export nach {$file} ist fehlgeschlagen ({$kind}).
