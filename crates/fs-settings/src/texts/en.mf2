# The words of the standard settings, English (ADR 0057: MessageFormat 2). Every id needs a German twin in de.mf2.
setting-label-fs-shell-language = Language
setting-about-fs-shell-language = The language of the program's words.
setting-label-fs-look-style = Style
setting-about-fs-look-style = The look of the program (its style).
setting-label-fs-look-scheme = Light or dark
setting-about-fs-look-scheme = Light or dark colours; without a choice the system decides.
setting-label-fs-shell-frontend = Program frontend
setting-about-fs-shell-frontend = The frontend the program opens. Without a choice the program's own default is used.
setting-label-fs-shell-refresh-ms = Check for changes every (ms)
setting-about-fs-shell-refresh-ms = How often the program looks for changed settings while a window is open.
setting-label-fs-mcp-enabled = AI entry (local) open
setting-about-fs-mcp-enabled = Opens the local entry through which an AI can connect to this computer. This is no right for an AI: who may take part is decided in the access settings. A program that runs as you on this computer is not stopped by this switch.
setting-error-reason-missing = Locking or unlocking {$key} needs a reason.
# the codes of SettingCode (32): one message per code, `setting-error-<code>`; the placeholders are its parameters
setting-error-key-invalid = The name {$key} is not a valid setting key.
setting-error-program-invalid = The program name {$program} is not valid.
setting-error-duplicate-key = The setting {$key} is declared twice.
setting-error-default-invalid = The default of {$key} does not fit its kind.
setting-error-not-declared = No building block declares the setting {$key}.
setting-error-wrong-type = The value of {$key} in the layer {$layer} has the wrong type.
setting-error-out-of-range = The value of {$key} in the layer {$layer} is out of range.
setting-error-unknown-choice = The value of {$key} in the layer {$layer} is not one of the choices.
setting-error-bad-language = The value of {$key} in the layer {$layer} is not a valid language tag.
setting-error-text-too-long = The text of {$key} in the layer {$layer} is too long.
setting-error-locked = {$key} is locked by {$by}: {$reason}
setting-error-lock-refused = The lock on {$key} holds nothing, because its value does not fit.
setting-error-unknown-key = The program does not know the setting {$key} (layer {$layer}); it is kept.
setting-error-file-unreadable = The file {$file} could not be read ({$kind}).
setting-error-file-broken = The file {$file} is broken.
setting-error-file-too-large = The file {$file} is too large.
setting-error-not-regular = {$file} is not a regular file.
setting-error-write-failed = The file {$file} could not be written ({$kind}); nothing changed.
setting-error-no-folder = There is no folder for the {$which} settings; the defaults are used.
setting-error-no-right = You may not lock or change the instance setting {$key}.
setting-error-profile = The profile {$name} was refused ({$cause}).
setting-error-store-broken = The settings store {$file} is damaged ({$cause}); the defaults are used and nothing is overwritten.
setting-error-store-newer = The settings store {$file} was written by a newer program (version {$found}, this one knows {$known}); it is not opened.
setting-error-store-unreachable = The settings service at {$socket} cannot be reached; the defaults are used.
setting-error-store-busy = The settings store is busy; try again.
setting-error-read-only = The {$which} settings are read only now.
setting-error-index-changed = The profile list changed in the meantime; try again.
setting-error-import-invalid = The file {$file} does not fit, line {$line}: {$cause}. Nothing was changed.
setting-error-import-conflict = The value of {$key} was not imported ({$cause}).
setting-error-export-failed = The export to {$file} failed ({$kind}).
setting-error-catalog-invalid = The settings file {$file} does not fit ({$cause}).
