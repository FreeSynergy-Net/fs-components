# The words of the standard shell (ADR 0065), English (ADR 0057: MessageFormat 2). Every id needs a German twin in de.mf2.
shell-menu-program = Program
shell-menu-view = View
shell-menu-help = Help
shell-settings = Settings
shell-settings-key = Setting at which the settings open
shell-quit = Quit
shell-help = Help
shell-about = About
shell-language = Language
shell-language-system = System language (default)
shell-language-shared = Like all programs ({$language})
shell-context-more = More options
shell-frontends = Frontends
shell-language-saved = Language changed. The menus use it now; the rest of the window changes at the next start.
shell-language-failed = The language could not be saved: {$reason}
# The name of a language in that language: never translated.
language-name-en = English
language-name-de = Deutsch

# Names of keys in the shortcuts a menu line shows (shown as Ctrl+S, Alt+Shift+P).
shell-key-control = Ctrl
shell-key-alt = Alt
shell-key-shift = Shift
shell-key-meta = Super
shell-key-delete = Del
shell-key-backspace = Backspace
shell-key-pageup = PgUp
shell-key-pagedown = PgDn

# A shortcut that two commands have: nothing runs, the person sees which.
shell-shortcut-conflict = The key {$keys} belongs to several commands ({$commands}). None of them was run.

# The commands of the notification module (ADR 0106): names of the commands and of their parameters, for the palette and the workflow editor.
shell-notification-tell = Tell
shell-notification-ask = Ask
shell-notification-close = Close notification
shell-notification-title = Title (key of a text)
shell-notification-body = Body (key of a text)
shell-notification-urgency = Urgency
low = Low
normal = Normal
critical = Critical
shell-notification-category = Category
shell-notification-scope = Occasion it belongs to
shell-notification-replaces = Replaces notification
shell-notification-expire = Stays for (ms, 0 = until closed)
shell-notification-params = Values for the texts (name=text, or name:number=3)
shell-notification-actions = Buttons (id=key of a text)
shell-notification-id = Id of the notification
