# Die Woerter der Standard-Fensterhuelle (ADR 0065), Deutsch (ADR 0057: MessageFormat 2). Jede Kennung braucht ihr englisches Gegenstueck in en.mf2.
shell-menu-program = Programm
shell-menu-view = Ansicht
shell-menu-help = Hilfe
shell-settings = Einstellungen
shell-settings-key = Einstellung, bei der die Einstellungen geöffnet werden
shell-quit = Beenden
shell-help = Hilfe
shell-about = Über
shell-language = Sprache
shell-language-system = Systemsprache (Standard)
shell-language-shared = Wie alle Programme ({$language})
shell-context-more = Weitere Optionen
shell-frontends = Frontends
shell-language-saved = Sprache geändert. Die Menüs verwenden sie sofort, der Rest des Fensters beim nächsten Start.
shell-language-failed = Die Sprache konnte nicht gespeichert werden: {$reason}
# Der Name einer Sprache in dieser Sprache: wird nie uebersetzt.
language-name-en = English
language-name-de = Deutsch

# Namen der Tasten in den Kürzeln, die eine Menüzeile zeigt (Strg+S, Alt+Umschalt+P).
shell-key-control = Strg
shell-key-alt = Alt
shell-key-shift = Umschalt
shell-key-meta = Super
shell-key-delete = Entf
shell-key-backspace = Rück
shell-key-pageup = Bild↑
shell-key-pagedown = Bild↓

# Ein Kürzel, das zwei Befehle haben: nichts läuft, die Person sieht welche.
shell-shortcut-conflict = Die Taste {$keys} gehört mehreren Befehlen ({$commands}). Keiner wurde ausgeführt.

# Die Befehle des Meldungsmoduls (ADR 0106): Namen der Befehle und ihrer Parameter, für die Palette und den Workflow-Editor.
shell-notification-tell = Melden
shell-notification-ask = Fragen
shell-notification-close = Meldung schließen
shell-notification-title = Titel (Kennung eines Textes)
shell-notification-body = Text (Kennung eines Textes)
shell-notification-urgency = Dringlichkeit
low = Niedrig
normal = Normal
critical = Kritisch
shell-notification-category = Kategorie
shell-notification-scope = Anlass, zu dem sie gehört
shell-notification-replaces = Ersetzt Meldung
shell-notification-expire = Bleibt (ms, 0 = bis geschlossen)
shell-notification-params = Werte für die Texte (Name=Text oder Name:number=3)
shell-notification-actions = Knöpfe (Kennung=Kennung eines Textes)
shell-notification-id = Kennung der Meldung

# Der Befehl `layout.frontend` (Menü Ansicht): die Zeile und ihr Parameter. Die Namen der Frontends sind Texte ihrer Anbieter.
shell-frontend = Frontend
shell-frontend-param = Frontend, zu dem gewechselt wird
