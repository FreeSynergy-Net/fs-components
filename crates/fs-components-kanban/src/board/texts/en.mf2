# The words of the board workbench, English (ADR 0057: MessageFormat 2). Every id needs a German twin in de.mf2.
board-add = Add card
board-quick-hint = Card title
board-empty = No cards yet
board-hidden =
  .input {$count :number}
  .match $count one {{{$count} hidden}} * {{{$count} hidden}}
board-more =
  .input {$count :number}
  .match $count one {{+ {$count} more}} * {{+ {$count} more}}
board-moved = Moved
board-undo = Undo
board-open = Open
board-close = Close
board-column-menu = Column menu
board-settings = Columns
board-over-limit = More cards than the limit
board-yes = Move anyway
board-no = Cancel
board-create-many =
  .input {$count :number}
  .match $count one {{Create {$count} card?}} * {{Create {$count} cards?}}
board-create = Create
board-detail-set = set
board-wip-over = over the limit
setting-label-fs-workbenches-board-detail-elements = Fields in the detail frame
setting-about-fs-workbenches-board-detail-elements = How many field values the frame at the side of the board shows for one card (it grows; nothing is dropped).
board-soon = soon
board-move-to = Move to...
board-move-soon = Moving cards: soon
