# The words the forms adapter of the board asks for (keys `kanban.*`, ids with a hyphen), ADR 0057: MessageFormat 2. Every id needs a twin in the other language.
kanban-rename = Umbenennen
kanban-limit = Grenze setzen
kanban-new_column = Neue Spalte
kanban-column_name = Name der Spalte
kanban-limit_placeholder = Anzahl Karten
kanban-limit_hint = Wie viele Karten die Spalte höchstens fassen soll; 0 = keine Grenze
kanban-limit_invalid = Das ist keine ganze Zahl; 0 bedeutet keine Grenze
kanban-refused-locked = Gesperrt: die Beschreibung erlaubt das nicht
kanban-refused-unsupported = Die Datenquelle kann das nicht
kanban-refused-unreachable = Die Datenquelle antwortet nicht
kanban-refused-conflict = Die Tafel hat sich inzwischen geändert; bitte noch einmal versuchen
kanban-refused-rejected = Die Datenquelle hat das abgelehnt
kanban-refused-no-board = Es gibt keine Tafel
kanban-refused-failed = Das hat nicht geklappt
