# Die Woerter der Zeitleiste, Deutsch (ADR 0057: MessageFormat 2). Jede Kennung braucht ihr englisches Gegenstueck in en.mf2. Der Schluessel timeline.zoom.day heisst hier timeline-zoom-day.
timeline-zoom-day = Tag
timeline-zoom-week = Woche
timeline-zoom-month = Monat
timeline-today = Heute
timeline-month-1 = Januar
timeline-month-2 = Februar
timeline-month-3 = März
timeline-month-4 = April
timeline-month-5 = Mai
timeline-month-6 = Juni
timeline-month-7 = Juli
timeline-month-8 = August
timeline-month-9 = September
timeline-month-10 = Oktober
timeline-month-11 = November
timeline-month-12 = Dezember
