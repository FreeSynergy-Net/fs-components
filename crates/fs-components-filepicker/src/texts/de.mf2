# Die Wörter des Datei-Wählers, Deutsch (ADR 0057: MessageFormat 2). Jede Kennung braucht ihr englisches Gegenstück in en.mf2.
filepicker-title-open-file = Datei wählen
filepicker-title-open-files = Dateien wählen
filepicker-title-save-file = Speichern unter
filepicker-title-folder = Ordner wählen
filepicker-button-open-file = Datei wählen…
filepicker-button-open-files = Dateien wählen…
filepicker-button-save-file = Speicherort wählen…
filepicker-button-folder = Ordner wählen…
filepicker-waiting = Der Dialog ist offen…
filepicker-nothing = Noch nichts gewählt
filepicker-provisional = Vorläufig: Pfadfeld, hier ist kein Datei-Dialog verfügbar
filepicker-path-placeholder = Pfad
filepicker-ok = OK
filepicker-cancel = Abbrechen
filepicker-problem-portal-unavailable = Der Datei-Dialog ist nicht verfügbar.
filepicker-problem-portal-timeout = Der Datei-Dialog hat nicht innerhalb von {$limit-ms} ms gestartet.
filepicker-problem-portal-denied = Der Datei-Dialog wurde verweigert: {$detail}
filepicker-problem-io = Die Datei konnte nicht gelesen werden: {$detail} ({$path})
filepicker-problem-path-missing = Diese Datei oder dieser Ordner existiert nicht: {$path}
filepicker-problem-path-unreadable = Nicht lesbar: {$path}
filepicker-problem-wrong-kind = Falsche Art (Datei oder Ordner): {$path}
